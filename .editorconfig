# EditorConfig for DroneDB Registry: https://editorconfig.org
#
# These rules describe what the code base already follows (RQ-03). A rule is
# a warning only if it has 0 violations today. The other rules are
# suggestions, so the build warning count does not change. Raise a rule to
# warning after its violations are fixed.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4

# Every file of these types already ends with a newline. The rule is not set
# for *.cs, *.json, *.md, *.xml and *.yml, because many of them have no
# final newline today.
[*.{csproj,props,targets,sln,sh,ps1,py,sql}]
insert_final_newline = true

[Dockerfile]
insert_final_newline = true

[*.{json,yml,yaml,xml,pubxml,gml}]
indent_size = 2

# Visual Studio writes solution files with tabs.
[*.sln]
indent_style = tab

[*.cs]
# Namespaces: file-scoped (0 block-scoped namespaces outside Migrations).
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning

# Naming of private fields.
#   private const              -> PascalCase  (DefaultTimeout)            0 violations: warning
#   private static readonly    -> PascalCase  (SupportedExtensions)       2 violations: suggestion
#   other private fields       -> _camelCase  (_logger, _consoleFilters)  10 violations: suggestion
# The violations are in RemoteThumbnailGenerator._httpClient, WmtsManager._transparentPng256
# and the m_ fields of Registry.Common/EchoStream.cs.
# Note: `dotnet build` reports IDE1006 only when EnforceCodeStyleInBuild is on and
# dotnet_diagnostic.IDE1006.severity is set. Neither is set today.
dotnet_naming_rule.private_constants_pascal.symbols = private_constants
dotnet_naming_rule.private_constants_pascal.style = pascal_case
dotnet_naming_rule.private_constants_pascal.severity = warning

dotnet_naming_rule.private_static_readonly_pascal.symbols = private_static_readonly_fields
dotnet_naming_rule.private_static_readonly_pascal.style = pascal_case
dotnet_naming_rule.private_static_readonly_pascal.severity = suggestion

dotnet_naming_rule.private_fields_underscore_camel.symbols = private_fields
dotnet_naming_rule.private_fields_underscore_camel.style = underscore_camel_case
dotnet_naming_rule.private_fields_underscore_camel.severity = suggestion

dotnet_naming_symbols.private_constants.applicable_kinds = field
dotnet_naming_symbols.private_constants.applicable_accessibilities = private
dotnet_naming_symbols.private_constants.required_modifiers = const

dotnet_naming_symbols.private_static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly_fields.required_modifiers = static, readonly

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

# EF Core scaffolds migrations with block-scoped namespaces. Do not edit them by hand.
[**/Migrations/*.cs]
dotnet_diagnostic.IDE0161.severity = none
