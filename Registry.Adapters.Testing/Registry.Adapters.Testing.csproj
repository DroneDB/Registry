<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Test doubles for the ports that Registry.Adapters implements (XI-09). Referenced by test
        projects only: FakeDdbWrapper replays the libddb contract fixtures vendored in Contract/
        (see README.md and Contract/SOURCE), so a test that uses it never loads native libddb.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsTestProject>false</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Newtonsoft.Json" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Registry.Ports\Registry.Ports.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The vendored files, byte for byte, as "Contract/<path>" (ContractFiles normalises the separator) -->
        <EmbeddedResource Include="Contract\**\*" Exclude="Contract\.gitattributes"
                          LogicalName="Contract/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

</Project>
