{
  "AppSettings": {
    "Secret": "",
    "TokenExpirationInDays": 7,
    "RevokedTokens": [],
    "AuthCookieName": "jwtToken",
    "ExternalUrlOverride": null,
    "ExternalAuthUrl": null,
    "MaxRequestBodySize": null,
    "AuthProvider": "Sqlite",
    "RegistryProvider": "Sqlite",
    "HangfireProvider": "InMemory",
    "CacheProvider": null,
    "ThumbnailsCacheExpiration": "00:30:00",
    "TilesCacheExpiration": "00:30:00",
    "DatasetVisibilityCacheExpiration": "1.00:00:00",
    "ClearCacheInterval": "01:00:00",
    "DefaultAdmin": {
      "Email": "admin@example.com",
      "UserName": "admin",
      "Password": "password123"
    },
    "StoragePath": "./data",
    "DatasetsPath": "./datasets",
    "CachePath": "./cache",
    "TempPath": "./temp",
    "UploadBatchTimeout": "01:00:00",
    "BatchTokenLength": 32,
    "RandomDatasetNameLength": 16,
    "EnableStorageLimiter": false,
    "MaxConcurrentDownloadsPerUser": null,
    "DisableAnonymousBulkDownloads": false,
    "WorkerThreads": -1,
    "RemoteThumbnailGeneratorUrl": null,
    "DefaultThumbnailSize": 512,
    "DatasetThumbnailCandidates": ["thumbnail.webp", "thumbnail.jpg", "thumbnail.png", "cover.webp", "cover.jpg", "cover.png"],
    "MonitorToken": null,
    "MaxZipMemoryThreshold": 1073741824,
    "MaxExportSizeBytes": 1073741824,
    "CleanupExpiredJobsCron": "0 * * * *",
    "SyncJobIndexStatesCron": "*/5 * * * *",
    "ProcessPendingBuildsCron": "* * * * *",
    "DatasetCleanupCron": "0 0 * * *",
    "ArtifactCompletenessCheckerCron": "0 2 * * *",
    "OrphanedDatasetCleanupCron": "0 3 * * *",
    "JobIndexCleanupCron": "0 4 * * *",
    "IndexReconciliationCron": "0 * * * *",
    "IndexQueue": {
      "BatchWindowMs": 20,
      "MaxBatchSize": 64,
      "QueueCapacityPerDataset": 512,
      "EnqueueTimeoutSeconds": 120
    },
    "Reconciliation": {
      "MaxItemsPerRun": 500,
      "QuarantineRetentionDays": 7
    },
    "JobIndexRetentionDays": 60,
    "HangfireJobRetentionDays": 2,
    "HangfireInvisibilityTimeoutHours": 4,
    "EnableOrganizationMemberManagement": false,
    "EnableDefaultUserOrganization": true,
    "AllowedOrigins": null,
    "PasswordPolicy": {
      "MinLength": 8,
      "RequireDigit": true,
      "RequireUppercase": false,
      "RequireLowercase": false,
      "RequireNonAlphanumeric": false
    },
    "HubOptions": {
      "AppLogo": "/images/logo-banner.svg",
      "AppName": null,
      "AppIcon": null,
      "ShowRegistrationLink": true,
      "DisableDatasetCreation": false,
      "DisableStorageInfo": false,
      "DisableAccountManagement": false,
      "SingleOrganization": null,
      "ReadOnlyOrgs": false,
      "Favicon": null
    },
    "Import": {
      "BlockedFileExtensions": [
        ".exe", ".dll", ".so", ".dylib", ".bat", ".cmd", ".com", ".msi", ".msix", ".appx",
        ".ps1", ".psm1", ".psd1", ".vbs", ".vbe", ".js", ".jse", ".wsf", ".wsh", ".hta",
        ".sh", ".bash", ".zsh", ".ksh", ".csh", ".run", ".elf", ".scr", ".pif", ".cpl",
        ".gadget", ".jar", ".apk", ".app", ".deb", ".rpm", ".py", ".pyc", ".pyo", ".rb",
        ".pl", ".php", ".lnk", ".reg", ".command", ".workflow"
      ],
      "AllowedFileExtensions": []
    }
  },
  "Serilog": {
    "LevelSwitches": {
      "$controlSwitch": "Warning"
    },
    "MinimumLevel": {
      "ControlledBy": "$controlSwitch"
    },
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "./logs/registry.txt"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Destructure": [
      {
        "Name": "ToMaximumDepth",
        "Args": {
          "maximumDestructuringDepth": 4
        }
      },
      {
        "Name": "ToMaximumStringLength",
        "Args": {
          "maximumStringLength": 100
        }
      },
      {
        "Name": "ToMaximumCollectionCount",
        "Args": {
          "maximumCollectionCount": 10
        }
      }
    ],
    "Properties": {
      "Application": "Registry"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IdentityConnection": "Data Source=./identity.db;Mode=ReadWriteCreate",
    "RegistryConnection": "Data Source=./registry.db;Mode=ReadWriteCreate"
  }
}