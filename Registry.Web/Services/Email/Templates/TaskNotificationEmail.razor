@*
    The HTML body of the task notification e-mail, made from the parsed template text: a blank line is a paragraph, a
    line break is a <br> and {{link}} alone in its paragraph is a button. Every value and every word of the
    administrator's text goes through Razor, which encodes it: the text cannot add markup. Only http(s) addresses become
    links (EmailLink, EmailButton).
*@
@inherits EmailBody<TaskNotificationEmailModel>

@foreach (var block in Model.Text.Body.Blocks(_values.Has))
{
    @switch (block)
    {
        case TemplateParagraph { Alone: TaskNotificationValues.Link }:
            <EmailButton Href="@_values.LinkUrl" Label="@_values.LinkLabel" Branding="@Branding" />
            break;
        case TemplateParagraph paragraph:
            <p style="margin:0 0 16px;">
                @for (var i = 0; i < paragraph.Lines.Count; i++)
                {
                    if (i > 0)
                    {
                        <br>
                    }
                    foreach (var part in paragraph.Lines[i])
                    {
                        if (part is TemplateText text)
                        {
                            @text.Text
                        }
                        else if (part is TemplateValue { Name: var name } && TaskNotificationValues.IsLink(name))
                        {
                            <EmailLink Href="@_values.LinkOf(name)" Branding="@Branding">@_values.LinkOf(name)</EmailLink>
                        }
                        else if (part is TemplateValue value)
                        {
                            @_values.Text(value.Name)
                        }
                    }
                }
            </p>
            break;
    }
}

@code {
    // Set by OnParametersSet, which runs before every render.
    private TaskNotificationValues _values = null!;

    protected override void OnParametersSet() => _values = new TaskNotificationValues(Model.Data, Branding);
}
