@*
    The frame of every HTML e-mail: an accent bar, the header with the logo (or the icon and the application name), the
    body of the template, the footer. Mail clients drop <style> blocks and external style sheets, and Outlook lays out
    only tables: every style is inline and the layout is a table. The colours come from the branding, validated as hex.
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <title>@Title</title>
</head>
<body style="margin:0;padding:0;background-color:#f3f4f6;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f3f4f6;">
    <tr>
        <td align="center" style="padding:24px 12px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;background-color:#ffffff;border:1px solid #e5e7eb;border-radius:8px;">
                <tr>
                    <td height="4" bgcolor="@Branding.AccentColor" style="height:4px;line-height:4px;font-size:0;background-color:@Branding.AccentColor;border-radius:8px 8px 0 0;">&nbsp;</td>
                </tr>
                <tr>
                    <td style="padding:20px 32px;border-bottom:1px solid #e5e7eb;font-family:@FontStack;font-size:20px;font-weight:600;color:#111827;">
                        @if (Branding.LogoUrl != null)
                        {
                            <img src="@Branding.LogoUrl" alt="@Branding.AppName" height="40" style="display:block;height:40px;width:auto;border:0;">
                        }
                        else if (Branding.IconUrl != null)
                        {
                            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td style="padding:0 12px 0 0;vertical-align:middle;">
                                        <img src="@Branding.IconUrl" alt="" width="32" height="32" style="display:block;width:32px;height:32px;border:0;border-radius:6px;">
                                    </td>
                                    <td style="vertical-align:middle;font-family:@FontStack;font-size:20px;font-weight:600;color:#111827;">@Branding.AppName</td>
                                </tr>
                            </table>
                        }
                        else
                        {
                            @Branding.AppName
                        }
                    </td>
                </tr>
                <tr>
                    <td style="padding:32px;font-family:@FontStack;font-size:16px;line-height:1.5;color:#111827;">
                        @ChildContent
                    </td>
                </tr>
                <tr>
                    <td style="padding:16px 32px;border-top:1px solid #e5e7eb;font-family:@FontStack;font-size:13px;line-height:1.5;color:#6b7280;">
                        Sent by @Branding.AppName
                        @if (Branding.BaseUrl != null)
                        {
                            <text> &middot; </text><a href="@Branding.BaseUrl" style="color:#6b7280;">@Branding.BaseUrl.Host</a>
                        }
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>

@code {
    private const string FontStack = EmailStyles.FontStack;

    /// <summary>The application name and links of this instance.</summary>
    [Parameter, EditorRequired]
    public EmailBranding Branding { get; set; }

    /// <summary>The document title: the subject of the e-mail.</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; }

    /// <summary>The body of the template.</summary>
    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; }
}
