@*
    A call to action that every mail client shows as a button: a table cell with a background colour (Outlook ignores
    padding and background on links) around a link with the same colour. The accent comes from the branding, already
    validated as hex, and the label colour is the one that reads best on it.
*@
@if (EmailLinks.IsWebUrl(Href))
{
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 16px;">
        <tr>
            <td align="center" bgcolor="@Branding.AccentColor" style="border-radius:6px;background-color:@Branding.AccentColor;">
                <a href="@Href" style="display:inline-block;padding:12px 24px;font-family:@EmailStyles.FontStack;font-size:16px;font-weight:600;line-height:20px;color:@Branding.AccentTextColor;text-decoration:none;border-radius:6px;">@Label</a>
            </td>
        </tr>
    </table>
}

@code {
    /// <summary>The address; no button unless it is an absolute http or https address.</summary>
    [Parameter, EditorRequired]
    public Uri Href { get; set; }

    /// <summary>The label.</summary>
    [Parameter, EditorRequired]
    public string Label { get; set; }

    /// <summary>The accent of the instance.</summary>
    [Parameter, EditorRequired]
    public EmailBranding Branding { get; set; }
}
