<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>Registry.Web</AssemblyName>
        <UserSecretsId>4e006835-31cb-47c5-9dfe-7b73e210db92</UserSecretsId>
        <SpaRoot>ClientApp/</SpaRoot>
        <DefaultItemExcludes>$(DefaultItemExcludes);$(SpaRoot)node_modules/**</DefaultItemExcludes>
        <AssemblyVersion>2.7.1</AssemblyVersion>
        <FileVersion>2.7.1</FileVersion>
        <Version>2.7.1</Version>
        <Platforms>AnyCPU;x64</Platforms>
        <PackageVersion>2.7.1</PackageVersion>
        <Configurations>Debug;Release;DebugEf</Configurations>
        <!-- Nullable allow-list (build/nullable-allowlist.txt): it may only shrink. -->
        <Nullable>disable</Nullable>
        <DdbVersion>1.12.2</DdbVersion>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyMetadata Include="DdbVersion" Value="$(DdbVersion)" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Registry.Web.Test" />
    </ItemGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'DebugEf' ">
      <DefineConstants>TRACE;DEBUG_EF</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="ddb-log*.csv" />
        <Content Remove="appsettings-default.json" />
        <EmbeddedResource Include="appsettings-default.json" />
        <None Remove="ClientApp.zip" />
        <None Remove="Properties/PublishProfiles/win-arm.pubxml" />
    </ItemGroup>

    <ItemGroup>
        <!-- Don't publish the SPA source files, but do show them in the project files list -->
        <Content Remove="$(SpaRoot)**" />
        <None Remove="$(SpaRoot)**" />
        <None Include="$(SpaRoot)**" Exclude="$(SpaRoot)node_modules/**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AspNetCore.HealthChecks.Hangfire" />
        <PackageReference Include="AspNetCore.HealthChecks.UI.Client" />
        <PackageReference Include="CommandLineParser" />
        <PackageReference Include="Hangfire.AspNetCore" />
        <PackageReference Include="Hangfire.Console" />
        <PackageReference Include="Hangfire.Core" />
        <PackageReference Include="Hangfire.InMemory" />
        <PackageReference Include="Hangfire.MySqlStorage" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" />
        <PackageReference Include="Microsoft.AspNetCore.SpaServices.Extensions" />
        <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
        <PackageReference Include="MimeMapping" />
        <PackageReference Include="Newtonsoft.Json" />
        <PackageReference Include="System.DirectoryServices.Protocols" />
        <PackageReference Include="Serilog.AspNetCore" />
        <PackageReference Include="Serilog.Enrichers.Environment" />
        <PackageReference Include="Serilog.Enrichers.Thread" />
        <PackageReference Include="Serilog.Extensions.Hosting" />
        <PackageReference Include="Serilog.Sinks.File" />
        <PackageReference Include="SkiaSharp" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
        <PackageReference Include="Scalar.AspNetCore" />
        <PackageReference Include="Swashbuckle.AspNetCore" />
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Registry.Adapters/Registry.Adapters.csproj" />
        <ProjectReference Include="../Registry.Common/Registry.Common.csproj" />
        <ProjectReference Include="../Registry.Web.Data.MySqlMigrations/Registry.Web.Data.MySqlMigrations.csproj" />
        <ProjectReference Include="../Registry.Web.Data.SqliteMigrations/Registry.Web.Data.SqliteMigrations.csproj" />
        <ProjectReference Include="../Registry.Web.Data/Registry.Web.Data.csproj" />
        <ProjectReference Include="../Registry.Web.Identity/Registry.Web.Identity.csproj" />
        <ProjectReference Include="../Registry.Web.Identity.MySqlMigrations/Registry.Web.Identity.MySqlMigrations.csproj" />
        <ProjectReference Include="../Registry.Web.Identity.SqliteMigrations/Registry.Web.Identity.SqliteMigrations.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Remove="appsettings-eftools.json" />
        <Content Include="appsettings-eftools.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    </ItemGroup>

    <ProjectExtensions>
        <VisualStudio>
            <UserProperties appsettings_1json__JsonSchema="" />
        </VisualStudio>
    </ProjectExtensions>

    <PropertyGroup>
        <DdbReleaseUrl>https://github.com/DroneDB/DroneDB/releases/download/v$(DdbVersion)/ddb-$(DdbVersion)-windows.zip</DdbReleaseUrl>
    </PropertyGroup>

    <Target Name="HandleNPMErrors">
        <Error Text="Cannot build SPA: Check ClientApp submodule and NodeJS version (22)" />
    </Target>

    <Target Name="BuildSPA">
        <Exec WorkingDirectory="ClientApp" Command="npm install" />
        <Exec WorkingDirectory="ClientApp" Command="npm run build" />
        <Message Text="SPA built" />
        <OnError ExecuteTargets="HandleNPMErrors" />
    </Target>


    <Target Name="EmbedDdbRelease">
        <PropertyGroup>
            <DdbReleasePath>$(OutputPath)ddb.zip</DdbReleasePath>
        </PropertyGroup>

        <Message Condition="Exists('$(DdbReleasePath)')" Text="Ddb release already exists at $(DdbReleasePath), skipping download" Importance="high" />
        <Message Condition="!Exists('$(DdbReleasePath)')" Text="Embedding ddb version $(DdbVersion), downloading from $(DdbReleaseUrl)" Importance="high" />

        <DownloadFile Condition="!Exists('$(DdbReleasePath)')" SourceUrl="$(DdbReleaseUrl)" DestinationFolder="$(OutputPath)" DestinationFileName="ddb.zip" />

        <ItemGroup>
            <EmbeddedResource Include="$(DdbReleasePath)">
                <LogicalName>Registry.Web.ddb.zip</LogicalName>
            </EmbeddedResource>
        </ItemGroup>

    </Target>


    <Target Name="PreBuild" BeforeTargets="PreBuildEvent">

        <Exec Command="dotnet tool restore" />

        <!-- Build Hub if not built -->
        <CallTarget Condition="!Exists('$(ProjectDir)/ClientApp/build')" Targets="BuildSPA" />

        <!--
          Embed the ddb release when the build targets Windows. The target OS is the RuntimeIdentifier,
          not the build OS: the release builds the win-* zips on Ubuntu. Without a RID (local dev build)
          the build OS decides, as before.
        -->
        <PropertyGroup>
            <EmbedDdbForTarget Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier.StartsWith('win'))</EmbedDdbForTarget>
            <EmbedDdbForTarget Condition="'$(RuntimeIdentifier)' == ''">$([MSBuild]::IsOSPlatform('Windows'))</EmbedDdbForTarget>
        </PropertyGroup>
        <CallTarget Condition="'$(EmbedDdbForTarget)' == 'true'" Targets="EmbedDdbRelease" />

        <Delete Files="$(ProjectDir)/ClientApp.zip" />

        <!--
          Stamp the Hub semantic version (read from ClientApp/package.json) into the build
          output so it ends up inside ClientApp.zip. Registry uses this marker to decide
          whether the on-disk Hub needs to be re-extracted after an upgrade.
        -->
        <PropertyGroup>
            <HubPackageJsonPath>$(ProjectDir)/ClientApp/package.json</HubPackageJsonPath>
            <HubVersion Condition="Exists('$(HubPackageJsonPath)')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(HubPackageJsonPath)')), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</HubVersion>
        </PropertyGroup>

        <Error
            Condition="!Exists('$(HubPackageJsonPath)')"
            Text="Hub package.json not found at '$(HubPackageJsonPath)'. Cannot stamp Hub version into ClientApp.zip." />
        <Error
            Condition="'$(HubVersion)' == ''"
            Text="Failed to extract a 'version' field from '$(HubPackageJsonPath)'. Cannot stamp Hub version into ClientApp.zip." />

        <Message Text="Stamping Hub version $(HubVersion) into ClientApp.zip" Importance="high" />

        <WriteLinesToFile
            File="$(ProjectDir)/ClientApp/build/version.txt"
            Lines="$(HubVersion)"
            Overwrite="true" />

        <ZipDirectory SourceDirectory="$(ProjectDir)/ClientApp/build" DestinationFile="$(ProjectDir)/ClientApp.zip" Overwrite="true" />

        <ItemGroup>
            <EmbeddedResource Include="ClientApp.zip" />
        </ItemGroup>
    </Target>

    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
       <Delete Files="$(ProjectDir)/ClientApp.zip" />
    </Target>


</Project>
