<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>Registry.Web</AssemblyName>
        <UserSecretsId>4e006835-31cb-47c5-9dfe-7b73e210db92</UserSecretsId>
        <SpaRoot>ClientApp/</SpaRoot>
        <DefaultItemExcludes>$(DefaultItemExcludes);$(SpaRoot)node_modules/**</DefaultItemExcludes>
        <AssemblyVersion>2.7.1</AssemblyVersion>
        <FileVersion>2.7.1</FileVersion>
        <Version>2.7.1</Version>
        <Platforms>AnyCPU;x64</Platforms>
        <PackageVersion>2.7.1</PackageVersion>
        <Configurations>Debug;Release</Configurations>
        <!-- Nullable allow-list (build/nullable-allowlist.txt): it may only shrink. -->
        <Nullable>disable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Registry.Web.UnitTest" />
        <InternalsVisibleTo Include="Registry.Web.IntegrationTest" />
        <InternalsVisibleTo Include="Registry.Web.TestSupport" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="ddb-log*.csv" />
        <Content Remove="appsettings-default.json" />
        <EmbeddedResource Include="appsettings-default.json" />
        <None Remove="ClientApp.zip" />
        <None Remove="Properties/PublishProfiles/win-arm.pubxml" />
    </ItemGroup>

    <ItemGroup>
        <!-- Don't publish the SPA source files, but do show them in the project files list -->
        <Content Remove="$(SpaRoot)**" />
        <None Remove="$(SpaRoot)**" />
        <None Include="$(SpaRoot)**" Exclude="$(SpaRoot)node_modules/**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AspNetCore.HealthChecks.Hangfire" />
        <PackageReference Include="AspNetCore.HealthChecks.UI.Client" />
        <PackageReference Include="CommandLineParser" />
        <PackageReference Include="Hangfire.AspNetCore" />
        <PackageReference Include="Hangfire.Console" />
        <PackageReference Include="Hangfire.Core" />
        <PackageReference Include="Hangfire.InMemory" />
        <PackageReference Include="Hangfire.MySqlStorage" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
        <PackageReference Include="Microsoft.AspNetCore.SpaServices.Extensions" />
        <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
        <PackageReference Include="MimeMapping" />
        <PackageReference Include="System.DirectoryServices.Protocols" />
        <PackageReference Include="Serilog.AspNetCore" />
        <PackageReference Include="Serilog.Enrichers.Environment" />
        <PackageReference Include="Serilog.Enrichers.Thread" />
        <PackageReference Include="Serilog.Extensions.Hosting" />
        <PackageReference Include="Serilog.Sinks.File" />
        <PackageReference Include="SkiaSharp" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
        <PackageReference Include="Scalar.AspNetCore" />
        <PackageReference Include="Swashbuckle.AspNetCore" />
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Registry.Adapters/Registry.Adapters.csproj" />
        <ProjectReference Include="../Registry.Common/Registry.Common.csproj" />
        <ProjectReference Include="../Registry.Web.Data.MySqlMigrations/Registry.Web.Data.MySqlMigrations.csproj" />
        <ProjectReference Include="../Registry.Web.Data.SqliteMigrations/Registry.Web.Data.SqliteMigrations.csproj" />
        <ProjectReference Include="../Registry.Web.Data/Registry.Web.Data.csproj" />
        <ProjectReference Include="../Registry.Web.Identity/Registry.Web.Identity.csproj" />
        <ProjectReference Include="../Registry.Web.Identity.MySqlMigrations/Registry.Web.Identity.MySqlMigrations.csproj" />
        <ProjectReference Include="../Registry.Web.Identity.SqliteMigrations/Registry.Web.Identity.SqliteMigrations.csproj" />
    </ItemGroup>

    <ProjectExtensions>
        <VisualStudio>
            <UserProperties appsettings_1json__JsonSchema="" />
        </VisualStudio>
    </ProjectExtensions>

    <PropertyGroup>
        <!-- The DroneDB pin (DdbSource, DdbVersion, DdbWindowsZipSha256, ...): Directory.Build.props -->
        <DdbReleaseUrl>https://github.com/DroneDB/DroneDB/releases/download/v$(DdbVersion)/ddb-$(DdbVersion)-Windows.zip</DdbReleaseUrl>
        <DdbReleaseScript>$(MSBuildThisFileDirectory)../scripts/ddb-release.sh</DdbReleaseScript>
    </PropertyGroup>

    <Target Name="HandleNPMErrors">
        <Error Text="Cannot build SPA: Check ClientApp submodule and NodeJS version (22)" />
    </Target>

    <Target Name="BuildSPA">
        <Exec WorkingDirectory="ClientApp" Command="npm install" />
        <Exec WorkingDirectory="ClientApp" Command="npm run build" />
        <Message Text="SPA built" />
        <OnError ExecuteTargets="HandleNPMErrors" />
    </Target>


    <!--
      Embeds the pinned ddb Windows build (Directory.Build.props). The zip is verified against
      DdbWindowsZipSha256 on every build: a cached zip that does not match (another pin, a broken
      download) is downloaded again, and a download that does not match fails the build and is deleted.
        - DdbSource release: MSBuild downloads the release asset (no bash needed on Windows).
        - DdbSource ci: scripts/ddb-release.sh fetch-windows-zip downloads the CI artifact, which
          needs bash, curl, unzip and DRONEDB_ARTIFACT_TOKEN (or a gh login).
        - DDB_LOCAL_BUILD=<path to a ddb Windows zip>: that zip is embedded instead, unverified
          (developer override).
    -->
    <Target Name="EmbedDdbRelease">
        <PropertyGroup>
            <DdbReleasePath>$(OutputPath)ddb.zip</DdbReleasePath>
            <DdbDownloadDir>$(OutputPath)ddb-download</DdbDownloadDir>
            <DdbLocalZip Condition="'$(DDB_LOCAL_BUILD)' != '' And $(DDB_LOCAL_BUILD.EndsWith('.zip'))">$(DDB_LOCAL_BUILD)</DdbLocalZip>
        </PropertyGroup>

        <Error Condition="'$(DdbWindowsZipSha256)' == ''" Text="DdbWindowsZipSha256 is not set (Directory.Build.props): the embedded ddb build cannot be verified." />

        <!-- Developer override -->
        <Warning Condition="'$(DdbLocalZip)' != ''" Text="DDB_LOCAL_BUILD: embedding $(DdbLocalZip) instead of the pinned DroneDB build; it is not checksum-verified." />
        <Copy Condition="'$(DdbLocalZip)' != ''" SourceFiles="$(DdbLocalZip)" DestinationFiles="$(DdbReleasePath)" />

        <!-- The pinned build: reuse a cached zip only when it is the pinned one -->
        <GetFileHash Condition="'$(DdbLocalZip)' == '' And Exists('$(DdbReleasePath)')" Files="$(DdbReleasePath)" Algorithm="SHA256">
            <Output TaskParameter="Hash" PropertyName="DdbCachedReleaseHash" />
        </GetFileHash>
        <Message Condition="'$(DdbLocalZip)' == '' And Exists('$(DdbReleasePath)') And '$(DdbCachedReleaseHash)' != '$(DdbWindowsZipSha256)'" Text="Ddb build at $(DdbReleasePath) is not the pinned one (SHA256 $(DdbCachedReleaseHash)), downloading it again" Importance="high" />
        <Delete Condition="'$(DdbLocalZip)' == '' And Exists('$(DdbReleasePath)') And '$(DdbCachedReleaseHash)' != '$(DdbWindowsZipSha256)'" Files="$(DdbReleasePath)" />
        <Message Condition="'$(DdbLocalZip)' == '' And Exists('$(DdbReleasePath)')" Text="Pinned ddb $(DdbVersion) ($(DdbSource)) already at $(DdbReleasePath), skipping download" Importance="high" />

        <Message Condition="'$(DdbLocalZip)' == '' And !Exists('$(DdbReleasePath)') And '$(DdbSource)' == 'release'" Text="Embedding ddb $(DdbVersion), downloading $(DdbReleaseUrl)" Importance="high" />
        <DownloadFile Condition="'$(DdbLocalZip)' == '' And !Exists('$(DdbReleasePath)') And '$(DdbSource)' == 'release'" SourceUrl="$(DdbReleaseUrl)" DestinationFolder="$(OutputPath)" DestinationFileName="ddb.zip" />

        <Message Condition="'$(DdbLocalZip)' == '' And !Exists('$(DdbReleasePath)') And '$(DdbSource)' == 'ci'" Text="Embedding the pinned ddb CI build $(DdbCiCommit) (run $(DdbCiRunId)), downloading it with scripts/ddb-release.sh" Importance="high" />
        <Exec Condition="'$(DdbLocalZip)' == '' And !Exists('$(DdbReleasePath)') And '$(DdbSource)' == 'ci'" Command="bash &quot;$(DdbReleaseScript)&quot; fetch-windows-zip &quot;$(DdbDownloadDir)&quot;" ContinueOnError="true">
            <Output TaskParameter="ExitCode" PropertyName="DdbFetchExitCode" />
        </Exec>
        <Error Condition="'$(DdbFetchExitCode)' != '' And '$(DdbFetchExitCode)' != '0'" Text="Cannot download the pinned ddb CI build (exit $(DdbFetchExitCode)). It needs bash, curl, unzip and DRONEDB_ARTIFACT_TOKEN (see scripts/ddb-release.sh); or set DDB_LOCAL_BUILD to a ddb Windows zip." />
        <Copy Condition="'$(DdbFetchExitCode)' == '0'" SourceFiles="$(DdbDownloadDir)/ddb-$(DdbVersion)-Windows.zip" DestinationFiles="$(DdbReleasePath)" />
        <RemoveDir Condition="'$(DdbFetchExitCode)' == '0'" Directories="$(DdbDownloadDir)" />

        <GetFileHash Condition="'$(DdbLocalZip)' == ''" Files="$(DdbReleasePath)" Algorithm="SHA256">
            <Output TaskParameter="Hash" PropertyName="DdbReleaseHash" />
        </GetFileHash>
        <Delete Condition="'$(DdbLocalZip)' == '' And '$(DdbReleaseHash)' != '$(DdbWindowsZipSha256)'" Files="$(DdbReleasePath)" />
        <Error Condition="'$(DdbLocalZip)' == '' And '$(DdbReleaseHash)' != '$(DdbWindowsZipSha256)'" Text="Checksum mismatch for the pinned ddb Windows build: SHA256 $(DdbReleaseHash), expected $(DdbWindowsZipSha256) (DdbWindowsZipSha256, Directory.Build.props). The download was deleted." />

        <ItemGroup>
            <EmbeddedResource Include="$(DdbReleasePath)">
                <LogicalName>Registry.Web.ddb.zip</LogicalName>
            </EmbeddedResource>
        </ItemGroup>

    </Target>


    <Target Name="PreBuild" BeforeTargets="PreBuildEvent">

        <Exec Command="dotnet tool restore" />

        <!-- Build Hub if not built -->
        <CallTarget Condition="!Exists('$(ProjectDir)/ClientApp/build')" Targets="BuildSPA" />

        <!--
          Embed the ddb release when the build targets Windows. The target OS is the RuntimeIdentifier,
          not the build OS: the release builds the win-* zips on Ubuntu. Without a RID (local dev build)
          the build OS decides, as before.
        -->
        <PropertyGroup>
            <EmbedDdbForTarget Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier.StartsWith('win'))</EmbedDdbForTarget>
            <EmbedDdbForTarget Condition="'$(RuntimeIdentifier)' == ''">$([MSBuild]::IsOSPlatform('Windows'))</EmbedDdbForTarget>
        </PropertyGroup>
        <CallTarget Condition="'$(EmbedDdbForTarget)' == 'true'" Targets="EmbedDdbRelease" />

        <Delete Files="$(ProjectDir)/ClientApp.zip" />

        <!--
          Stamp the Hub semantic version (read from ClientApp/package.json) into the build
          output so it ends up inside ClientApp.zip. Registry uses this marker to decide
          whether the on-disk Hub needs to be re-extracted after an upgrade.
        -->
        <PropertyGroup>
            <HubPackageJsonPath>$(ProjectDir)/ClientApp/package.json</HubPackageJsonPath>
            <HubVersion Condition="Exists('$(HubPackageJsonPath)')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(HubPackageJsonPath)')), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</HubVersion>
        </PropertyGroup>

        <Error
            Condition="!Exists('$(HubPackageJsonPath)')"
            Text="Hub package.json not found at '$(HubPackageJsonPath)'. Cannot stamp Hub version into ClientApp.zip." />
        <Error
            Condition="'$(HubVersion)' == ''"
            Text="Failed to extract a 'version' field from '$(HubPackageJsonPath)'. Cannot stamp Hub version into ClientApp.zip." />

        <Message Text="Stamping Hub version $(HubVersion) into ClientApp.zip" Importance="high" />

        <WriteLinesToFile
            File="$(ProjectDir)/ClientApp/build/version.txt"
            Lines="$(HubVersion)"
            Overwrite="true" />

        <ZipDirectory SourceDirectory="$(ProjectDir)/ClientApp/build" DestinationFile="$(ProjectDir)/ClientApp.zip" Overwrite="true" />

        <ItemGroup>
            <EmbeddedResource Include="ClientApp.zip" />
        </ItemGroup>
    </Target>

    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
       <Delete Files="$(ProjectDir)/ClientApp.zip" />
    </Target>


</Project>
