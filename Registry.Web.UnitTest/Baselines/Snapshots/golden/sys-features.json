        ],
        "rootReservedNames": [
          ".uploads"
        ],
        "description": "a name that is not empty, not '.' or '..', has no '/', '\\' or NUL character, does not start with a drive (such as 'C:') and is not a reserved name"
      },
      "nameClash": {
