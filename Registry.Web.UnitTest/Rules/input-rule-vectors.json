{
  "description": "Test cases of the input rules that GET /sys/features publishes (FR-XC-12, D-014). The Registry runs them against its own checks and the published patterns (InputRulesTests, SlugRulesTests); the Hub keeps a copy and runs it against libs/nameRules.js and libs/slug.js. 'server' is the Registry's answer; 'precheck' is what a client answers with the published rule (pattern, reserved names). For slugs and Latin names both always agree.",
  "slug": {
    "accept": ["ab", "a0", "00", "a-", "a_", "my-org_1", "a-b-c", "survey-team", "0-"],
    "reject": ["", "o", "0", "-", "_", "-ab", "_ab", "Ab", "AB", "a b", "a/b", "a--b", "ab--", "a.b", "é1", "ab ", " ab"]
  },
  "name": {
    "accept": ["a", "0", "bob", "user42", "42", "abc123xyz", "a0b1"],
    "reject": ["", " ", "TADMIN", "Bob", "t-admin-user", "bad name!", "a/b", "a.b", "a_b", "a-b", "a@b", "a+b", "bob ", " bob", "é", "ñandú", "Москва", "a\nb"]
  },
