{
  "description": "Test cases of the input rules that GET /sys/features publishes (FR-XC-12, D-014). The Registry runs them against its own checks and the published patterns (InputRulesTests, SlugRulesTests); the Hub keeps a copy and runs it against libs/nameRules.js and libs/slug.js. 'server' is the Registry's answer; 'precheck' is what a client answers with the published rule (pattern, reserved names). For slugs and Latin names both always agree.",
  "slug": {
    "accept": ["ab", "a0", "00", "a-", "a_", "my-org_1", "a-b-c", "survey-team", "0-"],
    "reject": ["", "o", "0", "-", "_", "-ab", "_ab", "Ab", "AB", "a b", "a/b", "a--b", "ab--", "a.b", "é1", "ab ", " ab"]
  },
  "email": [
    { "value": "jane@example.com", "server": true, "precheck": true },
    { "value": "first.last+tag@sub.example.co.uk", "server": true, "precheck": true },
    { "value": "a@b", "server": true, "precheck": true, "note": "a domain without a dot is an address" },
    { "value": "jane", "server": false, "precheck": false },
    { "value": "jane@", "server": false, "precheck": false },
    { "value": "@example.com", "server": false, "precheck": false },
    { "value": "", "server": false, "precheck": false },
    { "value": "   ", "server": false, "precheck": false },
    { "value": "jane doe@example.com", "server": false, "precheck": false },
    { "value": "jane@exa mple.com", "server": false, "precheck": false },
    { "value": "Jane <jane@example.com>", "server": false, "precheck": false, "note": "a display name is not an address" },
    { "value": "jane@example.com, joe@example.com", "server": false, "precheck": false, "note": "a list is not one address" },
    { "value": "jane@example.com,joe@example.com", "server": false, "precheck": false },
    { "value": "a@b@c", "server": false, "precheck": false },
    { "value": "<jane@example.com>", "server": false, "precheck": true, "note": "the pre-check is looser: the server decides" }
  ],
  "entryName": [
    { "name": "photo.jpg", "server": true, "precheck": true },
    { "name": "My Folder", "server": true, "precheck": true },
    { "name": "...", "server": true, "precheck": true },
    { "name": "..a", "server": true, "precheck": true },
    { "name": "b..c", "server": true, "precheck": true },
    { "name": "c..", "server": true, "precheck": true },
    { "name": " leading space", "server": true, "precheck": true },
    { "name": "trailing space ", "server": true, "precheck": true },
    { "name": ".ddbx", "server": true, "precheck": true, "note": "only the exact segment .ddb is reserved" },
    { "name": ".DDBX", "server": true, "precheck": true },
    { "name": ".ddb_notes.txt", "server": true, "precheck": true },
    { "name": "x.ddb", "server": true, "precheck": true },
    { "name": ".ddb.x", "server": true, "precheck": true },
    { "name": " .ddb", "server": true, "precheck": true, "note": "leading spaces are part of the name" },
    { "name": "ddb", "server": true, "precheck": true },
    { "name": "ddb~", "server": true, "precheck": true },
    { "name": "ddb~1.txt", "server": true, "precheck": true },
    { "name": "ab:c", "server": true, "precheck": true, "note": "a colon after more than one character is not a drive" },
    { "name": "1:x", "server": true, "precheck": true },
    { "name": ".uploadsx", "server": true, "precheck": true },
    { "name": ".Uploads", "server": true, "precheck": true, "note": "a root reserved name is compared as written" },
    { "name": "Überflug é.jpg", "server": true, "precheck": true },
    { "name": "Москва", "server": true, "precheck": true },
    { "name": "", "server": false, "precheck": false },
    { "name": " ", "server": false, "precheck": false },
    { "name": "   ", "server": false, "precheck": false },
    { "name": ".", "server": false, "precheck": false },
    { "name": "..", "server": false, "precheck": false },
    { "name": "a/b", "server": false, "precheck": false, "note": "one name, not a path" },
    { "name": "a\\b", "server": false, "precheck": false },
    { "name": "/abs", "server": false, "precheck": false },
    { "name": "\\abs", "server": false, "precheck": false },
    { "name": "C:", "server": false, "precheck": false, "note": "a Windows drive" },
    { "name": "c:x", "server": false, "precheck": false },
    { "name": "a\u0000b", "server": false, "precheck": false },
    { "name": "\u0000", "server": false, "precheck": false },
    { "name": ".ddb", "server": false, "precheck": false, "note": "reserved in every folder" },
    { "name": ".DDB", "server": false, "precheck": false, "note": "in any ASCII letter case" },
    { "name": ".dDb", "server": false, "precheck": false },
    { "name": ".uploads", "server": false, "precheck": false, "note": "reserved at the dataset root" },
    { "name": ".ddb.", "server": false, "precheck": true, "note": "an alias of .ddb: left to the server" },
    { "name": ".ddb ", "server": false, "precheck": true },
    { "name": ".ddb::$INDEX_ALLOCATION", "server": false, "precheck": true },
    { "name": "DDB~1", "server": false, "precheck": true },
    { "name": "ddb~2", "server": false, "precheck": true }
  ],
  "entryNameInFolder": [
    { "name": ".uploads", "server": true, "precheck": true, "note": "reserved at the dataset root only" },
    { "name": ".ddb", "server": false, "precheck": false },
    { "name": " ", "server": false, "precheck": false }
  ],
  "latinName": {
    "accept": ["Survey Team", "a", "7", "2024", "Orsted Café", "Équipe Été", "Москва 2", "東京 HQ", "Ørsted"],
    "reject": ["", "   ", "Москва", "!!!@@@###", "東京", "Ωμέγα", "ｆｕｌｌ", "---", "__"]
  }
}
