<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Test helpers shared by every test project (test file system, download cache, loggers).
        It must not reference Registry.Web: Registry.Adapters.Ddb.Test, which DroneDB CI runs as
        the libddb contract suite, would otherwise build Registry.Web and the Hub. Web test
        helpers live in Registry.Web.TestSupport.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="NUnit" />
      <PackageReference Include="NUnit.Analyzers" PrivateAssets="all" />
      <PackageReference Include="Serilog" />
      <PackageReference Include="Serilog.Extensions.Logging" />
      <PackageReference Include="Serilog.Sinks.Console" />
      <PackageReference Include="Shouldly" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Registry.Common\Registry.Common.csproj" />
    </ItemGroup>

</Project>
