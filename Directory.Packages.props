<Project>

    <!--
        Central package management (RQ-03): every NuGet package version is set here, once.
        A project lists the package with <PackageReference Include="..." /> and no Version.
        PrivateAssets/IncludeAssets stay on the PackageReference in the project.

        Packages that ship together move together, so they share one version property:
          - DotNetPackagesVersion: ASP.NET Core, EF Core and Microsoft.Extensions.* packages
            of the .NET 10 servicing train (EF Core packages must all have the same version).
          - HangfireVersion, AspNetCoreHealthChecksVersion and SkiaSharpVersion: the packages
            of one family (SkiaSharp and its native assets must match).
        System.DirectoryServices.Protocols 9.0.0 is not part of the .NET 10 train and keeps its own version.
        Packages whose assemblies ship in the shared framework (Microsoft.NETCore.App or
        Microsoft.AspNetCore.App) are not referenced: NuGet reports them as NU1510.

        Transitive pinning (CentralPackageTransitivePinningEnabled) is off, so restore resolves the
        same transitive versions as before.
    -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <DotNetPackagesVersion>10.0.7</DotNetPackagesVersion>
        <HangfireVersion>1.8.23</HangfireVersion>
        <AspNetCoreHealthChecksVersion>9.0.0</AspNetCoreHealthChecksVersion>
        <SkiaSharpVersion>3.119.2</SkiaSharpVersion>
    </PropertyGroup>

    <!-- .NET 10 servicing train -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(DotNetPackagesVersion)" />
        <PackageVersion Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="$(DotNetPackagesVersion)" />
        <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="$(DotNetPackagesVersion)" />
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="$(DotNetPackagesVersion)" />
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(DotNetPackagesVersion)" />
        <PackageVersion Include="Microsoft.AspNetCore.SpaServices.Extensions" Version="$(DotNetPackagesVersion)" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(DotNetPackagesVersion)" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(DotNetPackagesVersion)" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(DotNetPackagesVersion)" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(DotNetPackagesVersion)" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="$(DotNetPackagesVersion)" />
        <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="$(DotNetPackagesVersion)" />
        <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="$(DotNetPackagesVersion)" />
        <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="$(DotNetPackagesVersion)" />
        <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="$(DotNetPackagesVersion)" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(DotNetPackagesVersion)" />
        <PackageVersion Include="Microsoft.Extensions.Options" Version="$(DotNetPackagesVersion)" />
    </ItemGroup>

    <!-- Data access -->
    <ItemGroup>
        <PackageVersion Include="Microting.EntityFrameworkCore.MySql" Version="10.0.7" />
        <PackageVersion Include="NetTopologySuite.Core" Version="1.15.3" />
    </ItemGroup>

    <!-- Background jobs and health checks -->
    <ItemGroup>
        <PackageVersion Include="AspNetCore.HealthChecks.Hangfire" Version="$(AspNetCoreHealthChecksVersion)" />
        <PackageVersion Include="AspNetCore.HealthChecks.UI.Client" Version="$(AspNetCoreHealthChecksVersion)" />
        <PackageVersion Include="Hangfire.AspNetCore" Version="$(HangfireVersion)" />
        <PackageVersion Include="Hangfire.Core" Version="$(HangfireVersion)" />
        <PackageVersion Include="Hangfire.Console" Version="1.4.3" />
        <PackageVersion Include="Hangfire.InMemory" Version="1.0.0" />
        <PackageVersion Include="Hangfire.MySqlStorage" Version="2.0.3" />
    </ItemGroup>

    <!-- Logging -->
    <ItemGroup>
        <PackageVersion Include="Serilog" Version="4.3.1" />
        <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
        <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
        <PackageVersion Include="Serilog.Enrichers.Thread" Version="4.0.0" />
        <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
        <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
        <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageVersion Include="Serilog.Sinks.NUnit" Version="1.0.3" />
    </ItemGroup>

    <!-- Web API, security and tooling -->
    <ItemGroup>
        <PackageVersion Include="CommandLineParser" Version="2.9.1" />
        <PackageVersion Include="Scalar.AspNetCore" Version="2.14.11" />
        <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.1.7" />
        <PackageVersion Include="System.DirectoryServices.Protocols" Version="9.0.0" />
        <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.18.0" />
    </ItemGroup>

    <!-- General purpose libraries -->
    <ItemGroup>
        <PackageVersion Include="MimeMapping" Version="4.0.0" />
        <PackageVersion Include="MimeTypes" Version="2.5.2" />
        <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageVersion Include="Polly" Version="8.6.6" />
        <PackageVersion Include="SharpCompress" Version="0.49.1" />
        <PackageVersion Include="SharpZipLib" Version="1.4.2" />
        <PackageVersion Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
        <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="$(SkiaSharpVersion)" />
    </ItemGroup>

    <!-- Tests -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
        <PackageVersion Include="Moq" Version="4.20.72" />
        <PackageVersion Include="NUnit" Version="4.6.0" />
        <PackageVersion Include="NUnit3TestAdapter" Version="6.2.0" />
        <PackageVersion Include="Shouldly" Version="4.3.0" />
        <PackageVersion Include="Testcontainers" Version="4.12.0" />
        <PackageVersion Include="Testcontainers.MariaDb" Version="4.12.0" />
    </ItemGroup>

</Project>
