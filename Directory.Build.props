<Project>

    <!--
        Solution-wide build defaults.

        XML documentation is generated for every project so that:
          - the API reference (Scalar/OpenAPI) can surface controller and DTO summaries, and
          - the compiler flags documentation that references parameters which no longer exist (CS1572).

        Noise from the convention-driven docs is suppressed:
          - CS1591: missing XML comment for a publicly visible member (we don't document everything).
          - CS1573: a parameter has no matching param tag (params are documented only when not self-evident).
    -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    </PropertyGroup>

    <!--
        Analyzer and nullable ratchet (RQ-03, decision D7).

        Nullable is on for every project. A project that is not annotated yet sets
        <Nullable>disable</Nullable> in its csproj and is listed in build/nullable-allowlist.txt.
        scripts/check-nullable-allowlist.sh fails when the two disagree, so the list can only shrink.
    -->
    <PropertyGroup>
        <Nullable>enable</Nullable>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <!--
        The DroneDB (libddb) release Registry is built and tested against (RQ-02 item 10, XI-01).

        This is the only place the version and the checksums are written:
          - Registry.Web.csproj embeds ddb-<DdbVersion>-Windows.zip in Windows builds and fails the
            build when its SHA256 is not DdbWindowsZipSha256;
          - CI installs ddb_<DdbVersion>_amd64.deb through scripts/ddb-release.sh, which reads these
            values and runs sha256sum -c;
          - the Dockerfile has the same values as ARG defaults. scripts/ddb-release.sh check (CI)
            fails when they differ from these, or when anything downloads releases/latest.

        To move to a new DroneDB release, change the three values here and the two Dockerfile ARGs.
        The checksums are the "digest" field of each asset (sha256 of the uploaded file) in:
            gh api repos/DroneDB/DroneDB/releases/tags/v<version>
    -->
    <PropertyGroup>
        <DdbVersion>1.12.2</DdbVersion>
        <DdbDebSha256>b1c2c86c368d2915ebf14112b835f475d4c47f4cafb46224c31e02b7566473c4</DdbDebSha256>
        <DdbWindowsZipSha256>2aa183060ffe279b4652ef22ab57ccd795ee6bd2d1d87ec79fa2b44e04604afd</DdbWindowsZipSha256>
    </PropertyGroup>

</Project>
