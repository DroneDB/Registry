<Project>

    <!--
        Solution-wide build defaults.

        XML documentation is generated for every project so that:
          - the API reference (Scalar/OpenAPI) can surface controller and DTO summaries, and
          - the compiler flags documentation that references parameters which no longer exist (CS1572).

        Noise from the convention-driven docs is suppressed:
          - CS1591: missing XML comment for a publicly visible member (we don't document everything).
          - CS1573: a parameter has no matching param tag (params are documented only when not self-evident).
    -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    </PropertyGroup>

    <!--
        Analyzer and nullable ratchet.

        Nullable is on for every project. A project that is not annotated yet sets
        <Nullable>disable</Nullable> in its csproj and is listed in build/nullable-allowlist.txt.
        scripts/check-nullable-allowlist.sh fails when the two disagree, so the list can only shrink.
    -->
    <PropertyGroup>
        <Nullable>enable</Nullable>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <!--
        The DroneDB (libddb) build Registry is built and tested against.

        This is the only place it is written. scripts/ddb-release.sh reads it for everything that
        installs libddb, downloads exactly this build and checks it with sha256sum -c:
          - CI installs the .deb (scripts/ddb-release.sh fetch-deb);
          - the Dockerfile installs the same .deb (fetch-deb, token as a build secret for a CI build);
          - Registry.Web.csproj embeds the Windows zip in Windows builds (release: downloaded by
            MSBuild; ci: fetch-windows-zip) and fails the build when its SHA256 differs.
        scripts/ddb-release.sh check (CI) fails when the pin is malformed or written elsewhere, or
        when anything downloads releases/latest. Startup checks the ABI of the loaded library
        (DdbAbi: libddb 2.x, ABI major 2, minor >= 0), not this version number.

        DdbSource:
          release  a published release: DdbVersion, and the SHA256 of ddb_<DdbVersion>_amd64.deb and
                   ddb-<DdbVersion>-Windows.zip (the "digest" of each asset, or SHA256SUMS, in
                   gh api repos/DroneDB/DroneDB/releases/tags/v<version>). Remove the Ci and
                   ArtifactId properties.
          ci       an unreleased DroneDB CI build (c-cpp.yml): the DroneDB commit, its run, the ids
                   of its "Linux-Binaries" and "Windows Binaries" artifacts
                   (gh api repos/DroneDB/DroneDB/actions/runs/<run>/artifacts), DdbVersion as that
                   build names its files, and the SHA256 of the .deb and of the zip inside them.
                   Downloading an artifact needs DRONEDB_ARTIFACT_TOKEN (see scripts/ddb-release.sh);
                   artifacts expire 90 days after their run.

                   DdbDebFileVersion (optional, ci only): the version in the .deb file name when it is
                   not DdbVersion. DroneDB names the .deb of an untagged build <package.json
                   version>~git<commit> (scripts/build-debian-package.sh; the commit is the pull
                   request merge commit for a PR run), e.g. ddb_2.0.0~git1813815_amd64.deb next to
                   ddb-2.0.0-Windows.zip. Remove the property with the move to the release.

        Pinned now (2026-10-26): DroneDB has ONE version, 2.0.0 (package.json); the libddb ABI follows
        it (ABI 2.0, semver: a removed export is a new major, an added one a new minor) and so does
        the handshake (libddb 2.x). It is not tagged until Registry is proven on it, so Registry pins
        the CI build of DroneDB fixes-and-optimizations commit 3f7f764, run 40358721352 (a pull
        request run of DroneDB#472, built from the merge with master; the .deb is named after that
        merge commit, 2.0.0~git81f128be), every job green (Linux and Windows builds and tests,
        ASan + UBSan, the Docker image). It brings DDBBuildEx, a build with a cap on its threads
        ({"threads": N}), which the background rebuild of models of an older layout calls, GPX and
        JPEG 2000 files, and the formula mask fix. Next: the v2.0.0 release (DdbSource release) once
        it is tagged.
    -->
    <PropertyGroup>
        <DdbSource>ci</DdbSource>
        <DdbVersion>2.0.0</DdbVersion>
        <DdbDebFileVersion>2.0.0~git81f128be</DdbDebFileVersion>
        <DdbCiCommit>3f7f7649151226ca22fd52523e4b36c35fc563e7</DdbCiCommit>
        <DdbCiRunId>40358721352</DdbCiRunId>
        <DdbDebArtifactId>12670531116</DdbDebArtifactId>
        <DdbWindowsArtifactId>12669946068</DdbWindowsArtifactId>
        <DdbDebSha256>4ab01c28eb90042f6e679ce9b254431fd51ecb8fe7afa20302b6837a2468a66f</DdbDebSha256>
        <DdbWindowsZipSha256>e507019409e54872504a366be324005420b2fb87cc55c7b34679f0e6d2168c31</DdbWindowsZipSha256>
    </PropertyGroup>

</Project>
