<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Configurations>Debug;Release</Configurations>
        <!-- NativeJson reads libddb's UTF-8 output in place -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
      <Compile Remove="DroneDB\Models\**" />
      <EmbeddedResource Remove="DroneDB\Models\**" />
      <None Remove="DroneDB\Models\**" />
    </ItemGroup>

    <ItemGroup>
      <!-- The adapter tests call the internal NativeDdb declarations and NativeCall -->
      <InternalsVisibleTo Include="Registry.Adapters.Ddb.Test" />
      <!-- The struct layout and marshalling rules of NativeDdb, checked without loading libddb -->
      <InternalsVisibleTo Include="Registry.Adapters.Test" />
    </ItemGroup>

    <ItemGroup>
      <!-- Only DDB (Ddb.cs): Hangfire reads jobs stored by earlier releases with Json.NET -->
      <PackageReference Include="Newtonsoft.Json" />
      <PackageReference Include="SharpCompress" />
    </ItemGroup>


    <ItemGroup>
      <ProjectReference Include="..\Registry.Common\Registry.Common.csproj" />
      <ProjectReference Include="..\Registry.Ports\Registry.Ports.csproj" />
    </ItemGroup>

</Project>
